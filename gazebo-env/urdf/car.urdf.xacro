<?xml version="1.0"?>
<robot name="slam_car" 
       xmlns:xacro="http://ros.org/wiki/xacro"
>

  <xacro:property name="wheelbase"        value="0.32"/>
  <xacro:property name="track_width"      value="0.25"/>
  <xacro:property name="wheel_radius"     value="0.05"/>
  <xacro:property name="wheel_width"      value="0.04"/>
  <xacro:property name="chassis_length"   value="0.40"/>
  <xacro:property name="chassis_width"    value="0.20"/>
  <xacro:property name="chassis_height"   value="0.10"/>
  <xacro:property name="chassis_mass"     value="1.5"/>
  <xacro:property name="wheel_mass"       value="0.05"/>
  <xacro:property name="steering_limit"   value="0.6"/>
  <xacro:property name="wheel_friction_mu" value="1.0"/>

  <!-- ============================================================
       TUREYEN  DEGERLER; isimlendirilmis ara degiskenler.
       Formul burada BIR KERE yazilir, kullanim yerlerinde sadece
       degisken ismi ge cer (ornek: chassis_ixx = ...  sonra
       asagida ixx="${chassis_ixx}"). Boylece "bu deger ne?" sorusunun
       cevabi degiskenin ADINDA, formulu her seferinde cozmeye gerek
       yok.
       ============================================================ -->

  <!-- Govde (base_link): kutu eylemsizligi + yer seviyesinden origin
       yuksekligi. imu_joint de bu z-yuksekligini kullanacak (govdenin
       geometrik merkeziyle ayni nokta oldugu icin). -->
  <xacro:property name="chassis_ixx"      value="${chassis_mass*(chassis_width*chassis_width+chassis_height*chassis_height)/12}"/>
  <xacro:property name="chassis_iyy"      value="${chassis_mass*(chassis_length*chassis_length+chassis_height*chassis_height)/12}"/>
  <xacro:property name="chassis_izz"      value="${chassis_mass*(chassis_length*chassis_length+chassis_width*chassis_width)/12}"/>
  <xacro:property name="chassis_origin_z" value="${wheel_radius + chassis_height/2}"/>

  <!-- Tekerlekler: 4'u de ayni fiziksel boyutta, o yuzden eylemsizlik
       TEK formul (macro icinde kullaniliyor). Montaj konumlari ise
       4 farkli isaret kombinasyonu; her biri kendi ismiyle. -->
  <xacro:property name="wheel_ixx_izz"    value="${wheel_mass*(3*wheel_radius*wheel_radius+wheel_width*wheel_width)/12}"/>
  <xacro:property name="wheel_iyy_spin"   value="${wheel_mass*wheel_radius*wheel_radius/2}"/>
  <xacro:property name="front_wheel_x"    value="${wheelbase/2}"/>
  <xacro:property name="rear_wheel_x"     value="${-wheelbase/2}"/>
  <xacro:property name="left_wheel_y"     value="${track_width/2}"/>
  <xacro:property name="right_wheel_y"    value="${-track_width/2}"/>
  <xacro:property name="wheel_mount_z"    value="${wheel_radius}"/>

  <!-- ============================================================
       LIDAR PARAMETRELERI
       ============================================================
       FIZIKSEL (govde/kutle; gorunur montaj parcasinin boyutu,
       fizik motorunun collision/inertia hesabi icin):
  -->
  <xacro:property name="lidar_radius"     value="0.03"/>
  <xacro:property name="lidar_height"     value="0.04"/>
  <xacro:property name="lidar_mass"       value="0.05"/>

  <!-- Tureyen degerler: eylemsizlik (dik silindir, eksen Z) +
       govdenin uzerine, cikinti olmadan oturacagi z-yuksekligi. -->
  <xacro:property name="lidar_ixx_iyy"    value="${lidar_mass*(3*lidar_radius*lidar_radius+lidar_height*lidar_height)/12}"/>
  <xacro:property name="lidar_izz"        value="${lidar_mass*lidar_radius*lidar_radius/2}"/>
  <xacro:property name="lidar_origin_z"   value="${wheel_radius + chassis_height + lidar_height}"/>

  <!-- OPERASYONEL (sensorun NASIL algiladigi; govde boyutuyla ilgisi
       yok, gercek bir lidar da ayni fiziksel kutuyla farkli menzil/
       cozunurluk secenekleriyle satilabilir):
       - lidar_min_range / lidar_max_range: algilayabildigi mesafe araligi
         (metre). Su anki degerler gercek TurtleBot3 LDS-01 lidar'inin
         donaniminda dogruladigimiz spesifikasyon ( ROBOTIS'in resmi
         turtlebot3_burger.gazebo.xacro dosyasindan
         cekilmisti). Daha genis/dar bir tarama alani test etmek
         istersen bu ikisini degistirmen yeterli.
       - lidar_samples: 360 derecelik tam turu kac ayri isinla taradigi
         (acisal cozunurluk = lidar_fov / lidar_samples).
       - lidar_range_resolution: mesafe olcumundeki en kucuk ayirt
         edilebilir adim (metre); gercek donanimin dijital
         cozunurlugunu temsil eder.
       - lidar_rate: saniyede kac tam tur taradigi (Hz).
       - lidar_noise_mean / lidar_noise_stddev: her mesafe olcumune
         eklenen Gauss gurultusunun ortalamasi ve standart sapmasi;
         stddev'i arttirmak "daha ucuz/gurultulu" bir lidar'i,
         azaltmak "daha hassas" bir lidar'i simule eder. SLAM
         algoritmasinin gurultuye dayanikliligini test etmek icin
         bu deger bilerek degistirilebilir.
  -->
  <xacro:property name="lidar_fov"              value="6.28318530718"/> <!-- 2*pi, tam 360 derece -->
  <xacro:property name="lidar_samples"          value="360"/>
  <xacro:property name="lidar_min_range"        value="0.12"/>
  <xacro:property name="lidar_max_range"        value="3.5"/>
  <xacro:property name="lidar_range_resolution" value="0.015"/>
  <xacro:property name="lidar_rate"             value="10"/>
  <xacro:property name="lidar_noise_mean"       value="0.0"/>
  <xacro:property name="lidar_noise_stddev"     value="0.01"/>

  <!-- ============================================================
       IMU PARAMETRELERI
       ============================================================
       FIZIKSEL: -->
  <xacro:property name="imu_size_x"       value="0.02"/>
  <xacro:property name="imu_size_y"       value="0.02"/>
  <xacro:property name="imu_size_z"       value="0.01"/>
  <xacro:property name="imu_mass"         value="0.01"/>

  <!-- Tureyen degerler: eylemsizlik (kutu). Montaj z-yuksekligi icin
       AYRI bir degisken TANIMLAMIYORUM; IMU govdenin tam geometrik
       merkezine monteli, yani zaten yukarida tanimli chassis_origin_z
       ile BIREBIR ayni nokta. Ayni seyi iki farkli isimle tutmak
       yerine, imu_joint asagida dogrudan chassis_origin_z'yi
       kullanacak; bu ayni zamanda "IMU govde merkezinde" tasarim
       kararini kodda da acikca gosteriyor. -->
  <xacro:property name="imu_ixx"          value="${imu_mass*(imu_size_y*imu_size_y+imu_size_z*imu_size_z)/12}"/>
  <xacro:property name="imu_iyy"          value="${imu_mass*(imu_size_x*imu_size_x+imu_size_z*imu_size_z)/12}"/>
  <xacro:property name="imu_izz"          value="${imu_mass*(imu_size_x*imu_size_x+imu_size_y*imu_size_y)/12}"/>

  <!-- OPERASYONEL:
       - imu_rate: saniyede kac olcum yaptigi (Hz); gercek MEMS
         IMU'lar genelde 100-200 Hz civarindadir.
       - imu_angular_velocity_stddev: jiroskopun (donus hizi) Gauss
         gurultusu standart sapmasi, rad/s cinsinden.
       - imu_linear_acceleration_stddev: ivmeolcerin gurultusu,
         m/s^2 cinsinden. Bu iki deger, EKF'e (robot_localization)
         verilecek gurultu/kovaryans ayarlarinin da referans noktasi
         olacak; gercekte simulasyonda ekledigimiz gurultu ile
         EKF'in "bu sensore ne kadar guveneyim" varsayimi tutarli
         olmali.
       - imu_noise_mean: her iki gurultu tipi icin de ortalama (bias),
         varsayilan 0; gercekci bir sabit sapma (bias) test etmek
         istersen bunu sifirdan farkli yapabilirsin. -->
  <xacro:property name="imu_rate"                        value="100"/>
  <xacro:property name="imu_noise_mean"                  value="0.0"/>
  <xacro:property name="imu_angular_velocity_stddev"     value="0.0003"/>
  <xacro:property name="imu_linear_acceleration_stddev"  value="0.02"/>

  <!-- ============================================================
       KAMERA PARAMETRELERI
       ============================================================
       FIZIKSEL: -->
  <xacro:property name="camera_size_x"    value="0.02"/>
  <xacro:property name="camera_size_y"    value="0.03"/>
  <xacro:property name="camera_size_z"    value="0.02"/>
  <xacro:property name="camera_mass"      value="0.01"/>

  <!-- Tureyen degerler: eylemsizlik (kutu) + govdenin on yuzunde,
       ust govde hizasindaki montaj konumu. -->
  <xacro:property name="camera_ixx"       value="${camera_mass*(camera_size_y*camera_size_y+camera_size_z*camera_size_z)/12}"/>
  <xacro:property name="camera_iyy"       value="${camera_mass*(camera_size_x*camera_size_x+camera_size_z*camera_size_z)/12}"/>
  <xacro:property name="camera_izz"       value="${camera_mass*(camera_size_x*camera_size_x+camera_size_y*camera_size_y)/12}"/>
  <xacro:property name="camera_origin_x"  value="${chassis_length/2}"/>
  <xacro:property name="camera_origin_z"  value="${wheel_radius + chassis_height*0.7}"/>

  <!-- camera_pitch: kamerayi YUKARI egen aci (radyan). Tag'ler duvarda
       z=1.2 m'de, kamera ise z=0.12 m'de; aradaki 1.08 m'lik fark
       yuzunden duz bakan bir kamera tag'i ancak 2.39 m'den UZAKTAN
       kadraja sigdirabiliyordu (daha yakinda tag kadrajin ustunden
       tasiyordu). 15 derece yukari pitch ile bu sinir 1.34 m'ye
       iniyor; ayrica oda merkezinden duvara olan 3.84 m'lik tipik
       calisma mesafesinde tag neredeyse tam optik eksene oturuyor
       (+0.7 derece), bu da PnP pose kestiriminde lens kenarindaki
       bozulmadan kacinmayi sagliyor.
       DIKKAT: ROS/REP-103 konvansiyonunda pitch +y ekseni etrafinda
       doner ve POZITIF pitch burnu ASAGI eger. Bu yuzden asagidaki
       camera_joint'te isaret NEGATIF kullaniliyor. -->
  <xacro:property name="camera_pitch"     value="0.2618"/> <!-- 15 derece -->
  <xacro:property name="camera_joint_pitch" value="${-camera_pitch}"/>

  <!-- OPERASYONEL:
       - camera_horizontal_fov: yatay gorus acisi (radyan). Genis FOV
         AprilTag'leri daha erken/genis acidan yakalar ama goruntude
         daha kucuk gosterir (tespit mesafesini kisaltabilir).
       - camera_image_width / camera_image_height: cikti coz unurlugu
         (piksel). Daha yuksek cozunurluk = daha uzaktan tag tespiti,
         ama daha fazla hesaplama yuku.
       - camera_clip_near / camera_clip_far: render motorunun neyi
         "gorunur" saydigi mesafe araligi (metre); gercek bir
         sensor spesifikasyonu degil, sadece render performansi/
         gorsel dogruluk ayari. far'i odanin en uzun kösegeninden
         (~9m) kucuk tutmak render yukunu azaltir.
       - camera_noise_mean / camera_noise_stddev: piksel basina
         eklenen Gauss gurultusu; gercek bir kamera sensorunun
         dijital gurultusunu (ISO gurultusu gibi) simule eder. -->
  <xacro:property name="camera_horizontal_fov"  value="1.15"/>
  <xacro:property name="camera_image_width"     value="640"/>
  <xacro:property name="camera_image_height"    value="480"/>
  <xacro:property name="camera_clip_near"       value="0.05"/>
  <xacro:property name="camera_clip_far"        value="15.0"/>
  <xacro:property name="camera_rate"            value="30"/>
  <xacro:property name="camera_noise_mean"      value="0.0"/>
  <xacro:property name="camera_noise_stddev"    value="0.007"/>

  <material name="chassis_color"><color rgba="0.85 0.1 0.1 1"/></material>
  <material name="wheel_color"><color rgba="0.1 0.1 0.1 1"/></material>
  <material name="sensor_dark"><color rgba="0.08 0.08 0.08 1"/></material>
  <material name="sensor_blue"><color rgba="0.1 0.3 0.85 1"/></material>

  <!-- base_footprint: Nav2/REP-105 uyumlulugu icin sanal referans
       frame'i. Çogu URDF ornegi base_link'i teker
       ekseni yuksekliginde tutar, ama bizim base_link origin'imiz zaten
       zeminde (z=0), butun teker joint origin'leri buna gore wheel_radius
       yukselikte tanimli. O yuzden base_footprint, base_link ile AYNI
       noktada (offset=0) olmali.

       TF agaci coakismasini da duzelttim: standart REP-105 zinciri
       odom -> base_footprint -> base_link seklinde OLMALI (ChatGPT bunu
       hic ele almamis). AckermannSteering plugin'i odom->base_link
       yayinliyordu; simdi child_frame_id'sini base_footprint yaptim,
       boylece base_link'in iki farkli parent'i (hem odom hem
       base_footprint) olma catismasi ortadan kalkiyor. -->
  <link name="base_footprint"/>
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 ${chassis_origin_z}" rpy="0 0 0"/>
      <geometry><box size="${chassis_length} ${chassis_width} ${chassis_height}"/></geometry>
      <material name="chassis_color"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${chassis_origin_z}" rpy="0 0 0"/>
      <geometry><box size="${chassis_length} ${chassis_width} ${chassis_height}"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 ${chassis_origin_z}" rpy="0 0 0"/>
      <mass value="${chassis_mass}"/>
      <inertia
        ixx="${chassis_ixx}" ixy="0" ixz="0"
        iyy="${chassis_iyy}" iyz="0"
        izz="${chassis_izz}"/>
    </inertial>
  </link>

  <xacro:macro name="wheel_link" params="name">
    <link name="${name}">
      <visual>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        <material name="wheel_color"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      </collision>
      <inertial>
        <mass value="${wheel_mass}"/>
        <inertia
          ixx="${wheel_ixx_izz}" ixy="0" ixz="0"
          iyy="${wheel_iyy_spin}" iyz="0"
          izz="${wheel_ixx_izz}"/>
      </inertial>
    </link>
  </xacro:macro>

  <link name="front_left_steer_link">
    <inertial><mass value="0.01"/><inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/></inertial>
  </link>
  <joint name="front_left_wheel_steering_joint" type="revolute">
    <parent link="base_link"/>
    <child link="front_left_steer_link"/>
    <origin xyz="${front_wheel_x} ${left_wheel_y} ${wheel_mount_z}" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-${steering_limit}" upper="${steering_limit}" effort="10" velocity="5"/>
  </joint>
  <xacro:wheel_link name="front_left_wheel_link"/>
  <joint name="front_left_wheel_joint" type="continuous">
    <parent link="front_left_steer_link"/>
    <child link="front_left_wheel_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="front_right_steer_link">
    <inertial><mass value="0.01"/><inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/></inertial>
  </link>
  <joint name="front_right_wheel_steering_joint" type="revolute">
    <parent link="base_link"/>
    <child link="front_right_steer_link"/>
    <origin xyz="${front_wheel_x} ${right_wheel_y} ${wheel_mount_z}" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-${steering_limit}" upper="${steering_limit}" effort="10" velocity="5"/>
  </joint>
  <xacro:wheel_link name="front_right_wheel_link"/>
  <joint name="front_right_wheel_joint" type="continuous">
    <parent link="front_right_steer_link"/>
    <child link="front_right_wheel_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <xacro:wheel_link name="rear_left_wheel_link"/>
  <joint name="rear_left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rear_left_wheel_link"/>
    <origin xyz="${rear_wheel_x} ${left_wheel_y} ${wheel_mount_z}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <xacro:wheel_link name="rear_right_wheel_link"/>
  <joint name="rear_right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rear_right_wheel_link"/>
    <origin xyz="${rear_wheel_x} ${right_wheel_y} ${wheel_mount_z}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- Wheel friction (ChatGPT incelemesinde bulunan gercek eksik;
       dogruladim: sdformat.org'un resmi "SDFormat extensions to URDF"
       sayfasinda <gazebo reference><mu1>/<mu2> gecerli, collision/
       surface/friction/ode/mu ve mu2'ye ceviriliyor. Onemi: friction
       olmadan tekerlekler fizikte kayabilir, bu da Ackermann odometri
       tahminini gercek hareketten saptirir; SLAM drift kaynagi. -->
  <gazebo reference="front_left_wheel_link">
    <mu1>${wheel_friction_mu}</mu1>
    <mu2>${wheel_friction_mu}</mu2>
  </gazebo>
  <gazebo reference="front_right_wheel_link">
    <mu1>${wheel_friction_mu}</mu1>
    <mu2>${wheel_friction_mu}</mu2>
  </gazebo>
  <gazebo reference="rear_left_wheel_link">
    <mu1>${wheel_friction_mu}</mu1>
    <mu2>${wheel_friction_mu}</mu2>
  </gazebo>
  <gazebo reference="rear_right_wheel_link">
    <mu1>${wheel_friction_mu}</mu1>
    <mu2>${wheel_friction_mu}</mu2>
  </gazebo>

  <gazebo>
    <plugin filename="ignition-gazebo-ackermann-steering-system"
            name="gz::sim::systems::AckermannSteering">
      <left_joint>front_left_wheel_joint</left_joint>
      <left_joint>rear_left_wheel_joint</left_joint>
      <right_joint>front_right_wheel_joint</right_joint>
      <right_joint>rear_right_wheel_joint</right_joint>
      <left_steering_joint>front_left_wheel_steering_joint</left_steering_joint>
      <right_steering_joint>front_right_wheel_steering_joint</right_steering_joint>
      <!-- kingpin_width: direksiyon pivot noktalari (kingpin) arasi
           mesafe; gercek bir aracta bu, tekerlegin DIS kenarindan
           degil, donus mili ekseninden olculur, o yuzden fiziksel
           olarak wheel_separation'dan (track_width, teker merkezleri
           arasi) biraz KUCUK olmasi beklenir. 2cm fark, kingpin'in
           teker merkezine gore ne kadar ice yerlestigini temsil eden
           kabaca bir varsayim; gercek bir arac modelliyorsan bunu
           gercek kingpin ofsetiyle degistir. -->
      <kingpin_width>${track_width - 0.02}</kingpin_width>
      <steering_limit>${steering_limit}</steering_limit>
      <wheel_base>${wheelbase}</wheel_base>
      <wheel_separation>${track_width}</wheel_separation>
      <wheel_radius>${wheel_radius}</wheel_radius>
      <min_velocity>-1.0</min_velocity>
      <max_velocity>2.0</max_velocity>
      <min_acceleration>-3.0</min_acceleration>
      <max_acceleration>3.0</max_acceleration>
      <topic>cmd_vel</topic>
      <odom_topic>odom</odom_topic>
      <tf_topic>tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <odom_publish_frequency>30</odom_publish_frequency>
    </plugin>

    <plugin filename="ignition-gazebo-joint-state-publisher-system"
            name="ignition::gazebo::systems::JointStatePublisher"/>
  </gazebo>

  <link name="lidar_link">
    <visual>
      <geometry><cylinder radius="${lidar_radius}" length="${lidar_height}"/></geometry>
      <material name="sensor_dark"/>
    </visual>
    <collision>
      <geometry><cylinder radius="${lidar_radius}" length="${lidar_height}"/></geometry>
    </collision>
    <inertial>
      <mass value="${lidar_mass}"/>
      <inertia
        ixx="${lidar_ixx_iyy}" ixy="0" ixz="0"
        iyy="${lidar_ixx_iyy}" iyz="0"
        izz="${lidar_izz}"/>
    </inertial>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0 0 ${lidar_origin_z}" rpy="0 0 0"/>
  </joint>

  <gazebo reference="lidar_link">
    <sensor name="lidar_sensor" type="gpu_lidar">
      <topic>scan</topic>
      <ignition_frame_id>lidar_link</ignition_frame_id>
      <update_rate>${lidar_rate}</update_rate>
      <always_on>1</always_on>
      <visualize>true</visualize>
      <lidar>
        <scan>
          <horizontal>
            <samples>${lidar_samples}</samples>
            <resolution>1</resolution>
            <min_angle>-${lidar_fov/2}</min_angle>
            <max_angle>${lidar_fov/2}</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>${lidar_min_range}</min>
          <max>${lidar_max_range}</max>
          <resolution>${lidar_range_resolution}</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>${lidar_noise_mean}</mean>
          <stddev>${lidar_noise_stddev}</stddev>
        </noise>
      </lidar>
    </sensor>
  </gazebo>

  <link name="imu_link">
    <visual>
      <geometry><box size="${imu_size_x} ${imu_size_y} ${imu_size_z}"/></geometry>
      <material name="sensor_blue"/>
    </visual>
    <collision>
      <geometry><box size="${imu_size_x} ${imu_size_y} ${imu_size_z}"/></geometry>
    </collision>
    <inertial>
      <mass value="${imu_mass}"/>
      <inertia
        ixx="${imu_ixx}" ixy="0" ixz="0"
        iyy="${imu_iyy}" iyz="0"
        izz="${imu_izz}"/>
    </inertial>
  </link>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 ${chassis_origin_z}" rpy="0 0 0"/>
  </joint>

  <gazebo reference="imu_link">
    <sensor name="imu_sensor" type="imu">
      <topic>imu</topic>
      <ignition_frame_id>imu_link</ignition_frame_id>
      <update_rate>${imu_rate}</update_rate>
      <always_on>1</always_on>
      <imu>
        <angular_velocity>
          <x><noise type="gaussian"><mean>${imu_noise_mean}</mean><stddev>${imu_angular_velocity_stddev}</stddev></noise></x>
          <y><noise type="gaussian"><mean>${imu_noise_mean}</mean><stddev>${imu_angular_velocity_stddev}</stddev></noise></y>
          <z><noise type="gaussian"><mean>${imu_noise_mean}</mean><stddev>${imu_angular_velocity_stddev}</stddev></noise></z>
        </angular_velocity>
        <linear_acceleration>
          <x><noise type="gaussian"><mean>${imu_noise_mean}</mean><stddev>${imu_linear_acceleration_stddev}</stddev></noise></x>
          <y><noise type="gaussian"><mean>${imu_noise_mean}</mean><stddev>${imu_linear_acceleration_stddev}</stddev></noise></y>
          <z><noise type="gaussian"><mean>${imu_noise_mean}</mean><stddev>${imu_linear_acceleration_stddev}</stddev></noise></z>
        </linear_acceleration>
      </imu>
    </sensor>
  </gazebo>

  <link name="camera_link">
    <visual>
      <geometry><box size="${camera_size_x} ${camera_size_y} ${camera_size_z}"/></geometry>
      <material name="sensor_dark"/>
    </visual>
    <collision>
      <geometry><box size="${camera_size_x} ${camera_size_y} ${camera_size_z}"/></geometry>
    </collision>
    <inertial>
      <mass value="${camera_mass}"/>
      <inertia
        ixx="${camera_ixx}" ixy="0" ixz="0"
        iyy="${camera_iyy}" iyz="0"
        izz="${camera_izz}"/>
    </inertial>
  </link>
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="${camera_origin_x} 0 ${camera_origin_z}" rpy="0 ${camera_joint_pitch} 0"/>
  </joint>

  <link name="camera_link_optical"/>
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_link_optical"/>
    <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
  </joint>

  <gazebo reference="camera_link">
    <sensor name="camera_sensor" type="camera">
      <topic>camera/image</topic>
      <ignition_frame_id>camera_link_optical</ignition_frame_id>
      <update_rate>${camera_rate}</update_rate>
      <always_on>1</always_on>
      <visualize>true</visualize>
      <camera>
        <horizontal_fov>${camera_horizontal_fov}</horizontal_fov>
        <camera_info_topic>camera/camera_info</camera_info_topic>
        <image>
          <width>${camera_image_width}</width>
          <height>${camera_image_height}</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>${camera_clip_near}</near>
          <far>${camera_clip_far}</far>
        </clip>
        <noise>
          <type>gaussian</type>
          <mean>${camera_noise_mean}</mean>
          <stddev>${camera_noise_stddev}</stddev>
        </noise>
      </camera>
    </sensor>
  </gazebo>

</robot>
